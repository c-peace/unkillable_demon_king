# Organizer services. Inject the real key only at runtime.
LUNIT_FM_API_URL=https://model.hackathon.lunit.io
LUNIT_FM_API_KEY=lunit_replace_me
LUNIT_FM_MODEL=Lunit/L2-preview
LUNIT_MCP_URL=https://mcp.hackathon.lunit.io/mcp

# Submission server contract.
HOST=0.0.0.0
PORT=8000

# Fail-soft latency policy. Budgets are sized for an iterative sufficiency loop:
# measured worst case is well inside the global deadline.
REQUEST_TIMEOUT_SEC=240
RETRIEVAL_TIMEOUT_SEC=90
L2_TIMEOUT_SEC=90
MCP_TIMEOUT_SEC=60
MAX_L2_RETRIES=1
EMPTY_OUTPUT_RETRIES=1
L2_MAX_TOKENS=4096
MAX_GENERATION_RETRIEVALS=2
MAX_RETRIEVAL_MODEL_ROUNDS=4
MAX_MCP_TOOL_CALLS=4
MAX_RETRIEVAL_QUERY_CHARS=4000

# Conservative defaults for isolated evaluation.
ENABLE_MCP=true
MCP_TOOL_MODE=family
CONVERSATION_REPRESENTATION=native
ENABLE_HIGH_RISK_REVIEW=true
PLANNER_POLICY=state
CLARIFICATION_POLICY=conditional
RETRIEVAL_LEDGER_POLICY=ledger
REVIEW_POLICY=conditional
EMPTY_RECOVERY_POLICY=stateful

# Semantic harness layers. Each boundary has a legacy/structural fallback so the
# effect and latency of the layer can be measured independently.
CLINICAL_STATE_POLICY=structured
ADMISSION_POLICY=claim
RETRIEVAL_SESSION_POLICY=cumulative
EVIDENCE_VERIFICATION_POLICY=high_risk
EVIDENCE_VERIFIER_TIMEOUT_SEC=30
RESPONSE_CONTRACT_POLICY=typed

# Sampling. The organizer's reference client pins greedy decoding; leaving these unset
# lets the server default apply, which degenerates on long or non-English answers.
L2_TEMPERATURE=0.0
L2_TOP_P=1.0
